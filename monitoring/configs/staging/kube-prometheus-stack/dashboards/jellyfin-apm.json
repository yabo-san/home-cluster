{
  "annotations": { "list": [] },
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["apm", "jellyfin"],
  "title": "Jellyfin APM",
  "uid": "jellyfin-apm",
  "description": "New Relic-style APM summary for Jellyfin (.NET) from its built-in Prometheus endpoint: throughput, error rate, response time, transactions, runtime.",
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": {}, "hide": 0, "refresh": 1 }
    ]
  },
  "panels": [
    {
      "type": "stat", "title": "Service",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 0 },
      "targets": [ { "refId": "A", "expr": "up{job=\"jellyfin\"}", "instant": true } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": { "defaults": {
        "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ],
        "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "red" }, { "value": 1, "color": "green" } ] } } }
    },
    {
      "type": "stat", "title": "Throughput (rpm)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 3, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(rate(http_requests_received_total{job=\"jellyfin\"}[5m])) * 60" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "type": "stat", "title": "Error rate (5xx)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 7, "y": 0 },
      "targets": [ { "refId": "A", "expr": "(sum(rate(http_requests_received_total{job=\"jellyfin\",code=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_requests_received_total{job=\"jellyfin\"}[5m]))" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2,
        "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 0.01, "color": "orange" }, { "value": 0.05, "color": "red" } ] } } }
    },
    {
      "type": "stat", "title": "Response time p95",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 11, "y": 0 },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"jellyfin\"}[5m])))" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3,
        "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 1, "color": "orange" }, { "value": 3, "color": "red" } ] } } }
    },
    {
      "type": "stat", "title": "Response time p99",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 15, "y": 0 },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"jellyfin\"}[5m])))" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3,
        "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 2, "color": "orange" }, { "value": 5, "color": "red" } ] } } }
    },
    {
      "type": "stat", "title": ".NET exceptions / min",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(rate(dotnet_exceptions_total{job=\"jellyfin\"}[5m])) * 60" } ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 5, "color": "orange" }, { "value": 30, "color": "red" } ] } } }
    },

    {
      "type": "timeseries", "title": "Web transactions time (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"jellyfin\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"jellyfin\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"jellyfin\"}[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }, "min": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "p99" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "p50" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] }
        ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Throughput by controller (req/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [ { "refId": "A", "expr": "sum by (controller) (rate(http_requests_received_total{job=\"jellyfin\"}[5m]))", "legendFormat": "{{controller}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 30, "stacking": { "mode": "normal" }, "showPoints": "never" }, "min": 0 } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    {
      "type": "timeseries", "title": "Error rate — 4xx vs 5xx (share of requests)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "(sum(rate(http_requests_received_total{job=\"jellyfin\",code=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_requests_received_total{job=\"jellyfin\"}[5m]))", "legendFormat": "5xx" },
        { "refId": "B", "expr": "(sum(rate(http_requests_received_total{job=\"jellyfin\",code=~\"4..\"}[5m])) or vector(0)) / sum(rate(http_requests_received_total{job=\"jellyfin\"}[5m]))", "legendFormat": "4xx" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" }, "min": 0 },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] }
        ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "table", "title": "Transactions — by endpoint (top by throughput)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "sum by (endpoint) (rate(http_requests_received_total{job=\"jellyfin\"}[5m])) * 60", "instant": true, "format": "table" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (endpoint, le) (rate(http_request_duration_seconds_bucket{job=\"jellyfin\"}[5m])))", "instant": true, "format": "table" },
        { "refId": "C", "expr": "sum by (endpoint) (rate(http_requests_received_total{job=\"jellyfin\",code=~\"5..\"}[5m])) / sum by (endpoint) (rate(http_requests_received_total{job=\"jellyfin\"}[5m]))", "instant": true, "format": "table" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
          "excludeByName": { "Time": true },
          "renameByName": { "endpoint": "Endpoint", "Value #A": "rpm", "Value #B": "p95 (s)", "Value #C": "5xx ratio" },
          "indexByName": { "endpoint": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3 } } },
        { "id": "sortBy", "options": { "sort": [ { "field": "rpm", "desc": true } ] } }
      ],
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "rpm" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "decimals", "value": 1 }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "basic" } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byName", "options": "p95 (s)" }, "properties": [ { "id": "unit", "value": "s" }, { "id": "decimals", "value": 3 }, { "id": "custom.cellOptions", "value": { "type": "color-text" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 1, "color": "orange" }, { "value": 3, "color": "red" } ] } }, { "id": "color", "value": { "mode": "thresholds" } } ] },
          { "matcher": { "id": "byName", "options": "5xx ratio" }, "properties": [ { "id": "unit", "value": "percentunit" }, { "id": "decimals", "value": 2 }, { "id": "custom.cellOptions", "value": { "type": "color-background" } }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "value": null, "color": "transparent" }, { "value": 0.01, "color": "orange" }, { "value": 0.05, "color": "red" } ] } }, { "id": "color", "value": { "mode": "thresholds" } } ] }
        ] },
      "options": { "showHeader": true, "cellHeight": "sm" }
    },

    {
      "type": "row", "title": ".NET runtime", "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 }, "panels": []
    },
    {
      "type": "timeseries", "title": "GC heap size",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 21 },
      "targets": [ { "refId": "A", "expr": "dotnet_gc_heap_size_bytes{job=\"jellyfin\"}", "legendFormat": "__auto" } ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal" }, "showPoints": "never" }, "min": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "GC pause ratio (time spent in GC)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 21 },
      "targets": [ { "refId": "A", "expr": "dotnet_gc_pause_ratio{job=\"jellyfin\"}", "legendFormat": "pause ratio" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "thresholdsStyle": { "mode": "line" } }, "min": 0,
        "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 0.2, "color": "red" } ] } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Exceptions / s",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 21 },
      "targets": [ { "refId": "A", "expr": "sum(rate(dotnet_exceptions_total{job=\"jellyfin\"}[5m]))", "legendFormat": "exceptions/s" } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never" }, "min": 0, "color": { "mode": "fixed", "fixedColor": "red" } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Thread pool — threads & avg queue length",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 28 },
      "targets": [
        { "refId": "A", "expr": "dotnet_threadpool_num_threads{job=\"jellyfin\"}", "legendFormat": "threads" },
        { "refId": "B", "expr": "rate(dotnet_threadpool_queue_length_sum{job=\"jellyfin\"}[5m]) / rate(dotnet_threadpool_queue_length_count{job=\"jellyfin\"}[5m])", "legendFormat": "avg queue length" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }, "min": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Process CPU (% of one core)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 28 },
      "targets": [ { "refId": "A", "expr": "rate(process_cpu_seconds_total{job=\"jellyfin\"}[5m]) * 100", "legendFormat": "cpu" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" }, "min": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Process memory (working set)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 28 },
      "targets": [
        { "refId": "A", "expr": "process_working_set_bytes{job=\"jellyfin\"}", "legendFormat": "working set" },
        { "refId": "B", "expr": "dotnet_total_memory_bytes{job=\"jellyfin\"}", "legendFormat": "managed heap" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }, "min": 0 } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}

    {
      "id": 10,
      "type": "timeseries",
      "title": "Error rate (share of requests)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum (rate(http_server_request_duration_seconds_count{service_name=\"romm\",http_response_status_code=~\"5..\"}[5m]))) or (sum (rate(http_server_request_duration_seconds_count{service_name=\"romm\"}[5m])) * 0)) / sum (rate(http_server_request_duration_seconds_count{service_name=\"romm\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "expr": "((sum (rate(http_server_request_duration_seconds_count{service_name=\"romm\",http_response_status_code=~\"4..\"}[5m]))) or (sum (rate(http_server_request_duration_seconds_count{service_name=\"romm\"}[5m])) * 0)) / sum (rate(http_server_request_duration_seconds_count{service_name=\"romm\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "4xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Transactions by endpoint",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{service_name=\"romm\"}[5m])) * 60",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (http_request_method, http_route, le) (rate(http_server_request_duration_seconds_bucket{service_name=\"romm\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "((sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{service_name=\"romm\",http_response_status_code=~\"5..\"}[5m]))) or (sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{service_name=\"romm\"}[5m])) * 0)) / sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{service_name=\"romm\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rpm"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "http_route": "Endpoint",
              "Value #A": "rpm",
              "Value #B": "p95",
              "Value #C": "error rate",
              "http_request_method": "Method"
            }
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "rpm",
            "desc": true
          }
        ]
      }
    },

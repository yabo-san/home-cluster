{
  "title": "RomM APM",
  "uid": "apm-romm",
  "tags": [
    "apm",
    "romm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "New Relic-style APM for RomM. Beyla eBPF metrics: every request counted, no app changes. Generated by gen_apm.py.",
  "links": [
    {
      "title": "Environment APM",
      "type": "link",
      "url": "/d/apm-environment"
    },
    {
      "title": "Traces APM (service map)",
      "type": "link",
      "url": "/d/traces-apm"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Apdex (T = 0.25s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(((sum (rate(http_server_request_duration_seconds_bucket{service_name=\"romm\",le=\"0.25\"}[5m]))) + (sum (rate(http_server_request_duration_seconds_bucket{service_name=\"romm\",le=\"1.0\"}[5m])))) / 2) / sum (rate(http_server_request_duration_seconds_count{service_name=\"romm\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Satisfied requests plus half of tolerating (up to 4T), over all requests."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Throughput (rpm)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate(http_server_request_duration_seconds_count{service_name=\"romm\"}[5m])) * 60",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate (5xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum (rate(http_server_request_duration_seconds_count{service_name=\"romm\",http_response_status_code=~\"5..\"}[5m]))) or (sum (rate(http_server_request_duration_seconds_count{service_name=\"romm\"}[5m])) * 0)) / sum (rate(http_server_request_duration_seconds_count{service_name=\"romm\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,

{
  "title": "Drop APM",
  "uid": "apm-drop",
  "tags": [
    "apm",
    "drop"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "New Relic-style APM for Drop. Tempo span metrics from the app's own OpenTelemetry traces. Generated by gen_apm.py.",
  "links": [
    {
      "title": "Environment APM",
      "type": "link",
      "url": "/d/apm-environment"
    },
    {
      "title": "Traces APM (service map)",
      "type": "link",
      "url": "/d/traces-apm"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Apdex (T = 0.512s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(((sum (rate(traces_spanmetrics_latency_bucket{service=\"drop\",span_kind=\"SPAN_KIND_SERVER\",le=\"0.512\"}[5m]))) + (sum (rate(traces_spanmetrics_latency_bucket{service=\"drop\",span_kind=\"SPAN_KIND_SERVER\",le=\"2.048\"}[5m])))) / 2) / sum (rate(traces_spanmetrics_calls_total{service=\"drop\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.85
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "description": "Satisfied requests plus half of tolerating (up to 4T), over all requests."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Throughput (rpm)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum (rate(traces_spanmetrics_calls_total{service=\"drop\",span_kind=\"SPAN_KIND_SERVER\"}[5m])) * 60",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate (error spans)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum (rate(traces_spanmetrics_calls_total{service=\"drop\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[5m]))) or (sum (rate(traces_spanmetrics_calls_total{service=\"drop\",span_kind=\"SPAN_KIND_SERVER\"}[5m])) * 0)) / sum (rate(traces_spanmetrics_calls_total{service=\"drop\",span_kind=\"SPAN_KIND_SERVER\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Response time p50",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=\"drop\",span_kind=\"SPAN_KIND_SERVER\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Response time p95",
      "datasource": {
        "type": "prometheus",

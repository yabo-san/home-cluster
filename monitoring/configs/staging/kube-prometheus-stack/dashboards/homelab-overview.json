{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["homelab", "overview"],
  "title": "Homelab Overview",
  "uid": "homelab-overview",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Nodes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Node availability",
      "description": "UP = the exporter is reachable and scraping. DOWN = target unreachable.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "up{job=~\".*node.*\"}", "legendFormat": "{{instance}} ({{job}})", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value_and_name", "orientation": "horizontal" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "red" }, { "value": 1, "color": "green" } ] }
        }
      }
    },
    {
      "type": "row",
      "title": "gooselab — storage pool disks (mergerfs branches)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "gauge",
      "title": "Per-disk usage — the union hides that these are individually full",
      "description": "One gauge per /mnt/diskN. mergerfs /mnt/data averages these out; per-branch is the truth.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"gooselab-node\",mountpoint=~\"/mnt/disk[0-9]+\"} / node_filesystem_size_bytes{job=\"gooselab-node\",mountpoint=~\"/mnt/disk[0-9]+\"})", "legendFormat": "{{mountpoint}}", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 80, "color": "yellow" }, { "value": 90, "color": "red" } ] }
        }
      }
    },
    {
      "type": "gauge",
      "title": "Pool /mnt/data (union)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        { "refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"gooselab-node\",mountpoint=\"/mnt/data\"} / node_filesystem_size_bytes{job=\"gooselab-node\",mountpoint=\"/mnt/data\"})", "legendFormat": "/mnt/data", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 80, "color": "yellow" }, { "value": 90, "color": "red" } ] }
        }
      }
    },
    {
      "type": "row",
      "title": "Drive health (SMART) & cluster nodes",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Drive temperature (°C)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 17 },
      "targets": [
        { "refId": "A", "expr": "smartctl_device_temperature{job=\"gooselab-smartctl\",temperature_type=\"current\"}", "legendFormat": "{{device}}", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "displayMode": "gradient" },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius", "min": 20, "max": 70,
          "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 45, "color": "yellow" }, { "value": 52, "color": "red" } ] }
        }
      }
    },
    {
      "type": "stat",
      "title": "SMART status (PASS = healthy)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 17 },
      "targets": [
        { "refId": "A", "expr": "smartctl_device_smart_status{job=\"gooselab-smartctl\"}", "legendFormat": "{{device}}", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "value_and_name", "orientation": "horizontal" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FAIL", "color": "red" }, "1": { "text": "PASS", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "red" }, { "value": 1, "color": "green" } ] }
        }
      }
    },
    {
      "type": "gauge",
      "title": "Cluster node root disk /",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 17 },
      "targets": [
        { "refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"node-exporter\",mountpoint=\"/\"})", "legendFormat": "{{instance}}", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 80, "color": "yellow" }, { "value": 90, "color": "red" } ] }
        }
      }
    }
  ]
}

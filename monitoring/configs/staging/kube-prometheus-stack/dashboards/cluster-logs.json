{
  "annotations": { "list": [] },
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["logs"],
  "title": "Cluster Logs",
  "uid": "cluster-logs",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(namespace)",
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "type": "logs",
      "title": "Logs — namespace=$namespace  ${search:text}",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 27, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{namespace=~\"$namespace\"} |~ \"(?i)$search\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending",
        "prettifyLogMessage": false
      }
    }
  ]
}
